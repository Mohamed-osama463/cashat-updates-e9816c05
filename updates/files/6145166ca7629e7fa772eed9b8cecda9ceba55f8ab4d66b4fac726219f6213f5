<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Cashat – نظام الكاشير</title>
<link rel="stylesheet" href="style.css">
<style>
  .app{height:100vh;display:flex;flex-direction:column;gap:clamp(10px,2.2vh,22px);padding:clamp(12px,2.6vh,30px) clamp(16px,3vw,48px);max-width:1240px;margin:0 auto}
  header{flex:none;display:flex;flex-direction:column;align-items:center;gap:2px}
  .brand{font-size:clamp(26px,5vh,40px);font-weight:800;letter-spacing:1.5px;line-height:1.1;background:linear-gradient(180deg,#ff6a76,var(--red));-webkit-background-clip:text;background-clip:text;color:transparent}
  .totals{flex:none;display:grid;grid-template-columns:1fr 1fr;gap:14px}
  .stat{padding:clamp(8px,1.6vh,16px) 18px;border-top:3px solid var(--red)}
  .stat small{display:block;color:var(--mute);font-size:13px}
  .stat b{font-size:clamp(22px,4vh,32px);font-weight:800;font-variant-numeric:tabular-nums;line-height:1.25}
  .grid{flex:1;min-height:0;display:grid;grid-template-columns:1fr 1fr;grid-template-rows:1fr 1fr;gap:clamp(10px,2vh,18px)}
  .tile{position:relative;min-height:0;border-radius:24px;color:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:clamp(4px,1.2vh,12px);overflow:hidden;box-shadow:var(--shadow);border:1px solid rgba(255,255,255,.08)}
  .tile::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(255,255,255,.13),transparent 50%);pointer-events:none}
  .tile:hover{transform:translateY(-3px);box-shadow:0 18px 44px rgba(225,29,46,.28)}
  .tile:active{transform:scale(.975)}
  .tile .ico{width:clamp(52px,10vh,84px);height:clamp(52px,10vh,84px);border-radius:22%;overflow:hidden;background:#fff;box-shadow:0 6px 18px rgba(0,0,0,.35);flex:none}
  .tile .ico img{width:100%;height:100%;object-fit:cover;display:block}
  .k3 .ico{background:transparent;box-shadow:none;overflow:visible}
  .tile h2{font-size:clamp(18px,3.2vh,26px)}
  .tile .big{font-size:clamp(24px,5vh,42px);font-weight:800;font-variant-numeric:tabular-nums;line-height:1.1}
  .tile .pill{background:rgba(0,0,0,.3);border-radius:99px;padding:2px 14px;font-size:clamp(12px,1.9vh,14px)}
  .k0{background:linear-gradient(145deg,#ff3f4e,#b4121f)}
  .k1{background:linear-gradient(145deg,#d3182a,#7a0f19)}
  .k2{background:linear-gradient(145deg,#a8121f,#3f0a0f)}
  .k3{background:linear-gradient(145deg,#1a1a20,#000);border:2px solid var(--red)}
  .k3 .big{color:var(--red-hi)}

  /* service dialog + keypad */
  .amt{font-size:42px;font-weight:800;font-variant-numeric:tabular-nums;height:74px;display:grid;place-items:center;background:var(--surface2);border:1px solid var(--line2);border-radius:14px;direction:ltr}
  .amt.empty{color:#55555f}
  .keys{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
  .key{height:clamp(44px,7vh,56px);border-radius:12px;background:var(--surface2);border:1px solid var(--line2);font-size:20px;font-weight:700;display:grid;place-items:center}
  .key:hover{border-color:var(--red);background:var(--surface3)}
  .key:active{transform:scale(.94)}

  /* store dialog */
  dialog.store{width:min(880px,95vw)}
  .pgrid{display:grid;grid-template-columns:repeat(3,1fr);grid-template-rows:repeat(2,minmax(0,1fr));gap:12px;height:clamp(230px,40vh,340px)}
  .prod{position:relative;border-radius:16px;background:var(--surface2);border:1px solid var(--line2);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;padding:10px}
  .prod:hover:not(:disabled){border-color:var(--red)}
  .prod:active:not(:disabled){transform:scale(.97)}
  .prod .nm{font-weight:700;font-size:16px;max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .prod .pr{color:var(--red-hi);font-weight:800;font-variant-numeric:tabular-nums}
  .prod .st{font-size:12.5px;color:var(--mute)}
  .prod.in{border-color:var(--red);background:var(--red-soft)}
  .prod .q{position:absolute;top:8px;inset-inline-start:8px;min-width:30px;height:30px;border-radius:99px;background:var(--red);color:#fff;display:grid;place-items:center;font-weight:800;padding:0 8px}
  .prod .m{position:absolute;top:8px;inset-inline-end:8px}
  .empty{display:grid;place-items:center;height:100%;color:var(--mute);grid-column:1/-1;grid-row:1/-1}
  .cartbar{display:flex;align-items:center;justify-content:space-between;gap:12px}
  .cartbar .tot{font-size:22px;font-weight:800;font-variant-numeric:tabular-nums}
  .cartbar .tot small{display:block;font-size:12px;color:var(--mute);font-weight:500}
  .undobtn{position:absolute;top:clamp(12px,2.6vh,30px);inset-inline-start:clamp(16px,3vw,48px);height:42px;padding:0 16px;color:#ff8792;border-color:rgba(255,80,96,.35)}
  .undobtn:hover:not(:disabled){border-color:#ff8792}
  dialog.pick{width:min(680px,95vw)}
  .pick .wrapt{border:1px solid var(--line);border-radius:14px;overflow:hidden;min-height:calc(42px + 5 * 52px)}
  .pick table{background:transparent}
  .pick td{height:52px}
  .pin-ic{width:54px;height:54px;border-radius:50%;margin:0 auto;display:grid;place-items:center;background:rgba(255,80,96,.14);color:#ff8792}
  #pinIn{font-size:26px;letter-spacing:8px;height:54px}
  .pinerr{min-height:20px;color:var(--warn);font-size:13px}
  dialog.shake{animation:shake .35s}
  @keyframes shake{20%,60%{transform:translateX(-8px)}40%,80%{transform:translateX(8px)}}
  @media (max-height:700px){.tile .pill{display:none}}
</style>
</head>
<body>
<div class="app">
  <button class="btn-ghost undobtn" id="undoBtn"></button>
  <header>
    <div class="brand">Cashat</div>
    <div class="muted"><span id="today"></span><span id="saved"></span></div>
  </header>

  <div class="totals">
    <div class="card stat"><small>أرباح اليوم</small><b id="tEarn"></b></div>
    <div class="card stat"><small>عمولة اليوم</small><b id="tComm"></b></div>
  </div>

  <div class="grid" id="grid"></div>
</div>

<dialog id="svcDlg"><div class="dlg">
  <h2 id="svcTitle"></h2>
  <div class="muted" id="svcRate"></div>
  <div class="amt empty" id="amt">0</div>
  <div class="muted" id="svcPreview">&nbsp;</div>
  <div class="keys" id="keys"></div>
  <div class="row"><button class="btn-ghost" id="svcCancel">إلغاء</button><button class="btn-pri" id="svcOk" disabled></button></div>
</div></dialog>

<dialog id="pickDlg" class="pick"><div class="dlg">
  <h2>اختر العملية للتراجع عنها</h2>
  <div class="muted">عمليات اليوم · التراجع يتطلب الرمز السري</div>
  <div class="wrapt" id="pickList"></div>
  <div class="pager" id="pickPg" style="height:40px"></div>
  <button class="btn-ghost" id="pickClose">إغلاق</button>
</div></dialog>

<dialog id="pinDlg"><div class="dlg">
  <div class="pin-ic" id="pinIc"></div>
  <h2>التراجع عن آخر عملية</h2>
  <div class="muted" id="pinWhat"></div>
  <input id="pinIn" type="password" inputmode="numeric" autocomplete="off" placeholder="الرمز السري">
  <div class="pinerr" id="pinErr"></div>
  <div class="row"><button class="btn-ghost" id="pinCancel">إلغاء</button><button class="btn-danger" id="pinOk">تراجع</button></div>
</div></dialog>

<dialog id="storeDlg" class="store"><div class="dlg">
  <h2 id="storeTitle"></h2>
  <div class="pgrid" id="pgrid"></div>
  <div class="pager" id="pgr" style="border:0;height:36px"></div>
  <div class="cartbar">
    <button class="btn-ghost" id="storeClose">إغلاق</button>
    <div class="tot"><small>إجمالي السلة</small><span id="cartTot">0.00</span></div>
    <div class="row" style="flex:0 0 auto"><button class="btn-ghost" id="cartClear">مسح</button><button class="btn-pri" id="cartOk" disabled></button></div>
  </div>
</div></dialog>

<script src="shared.js"></script>
<script src="cashier.js"></script>
</body>
</html>
